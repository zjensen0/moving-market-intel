# Copy to .env.local for local development. Never commit real keys.
# Supabase > Project settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for scripts/load_market_data.mjs (run on your computer or as a GitHub Actions secret).
# The service role key bypasses all access rules: keep it out of the website and out of git.
SUPABASE_SERVICE_ROLE_KEY=
